# SFTP credentials for local development.
# Copy this file to .env and replace every placeholder value.
# Keep .env out of Git and never commit real credentials.
SFTP_HOST=sl313.web.hostpoint.ch
SFTP_PORT=22
SFTP_USER=lovanina
# Use SSH public-key authentication for Hostpoint SFTP.
# The corresponding public key must already be installed for the account.
SFTP_PRIVATE_KEY=/Users/m/.ssh/id_ed25519
SFTP_BASE_DIR=/
PUBLIC_IMAGE_BASE_URL=https://www.gasthofzumwidder.ch/kalender

# Password authentication is not supported for this Hostpoint account.
# SFTP_PASSWORD=
