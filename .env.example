# SFTP credentials for local development.
# Copy this file to .env and replace every placeholder value.
# Keep .env out of Git and never commit real credentials.
SFTP_HOST=sftp.example.com
SFTP_PORT=22
SFTP_USER=your-sftp-username
# Quote the password if it contains spaces, #, $, or other dotenv-significant characters.
SFTP_PASSWORD="your-sftp-password"
SFTP_BASE_DIR=/
PUBLIC_IMAGE_BASE_URL=https://www.example.com/kalender

# Do not set SFTP_PRIVATE_KEY when using password authentication.
# The application currently does not support passphrases for encrypted private keys.
# SFTP_PRIVATE_KEY=./id_ed25519
